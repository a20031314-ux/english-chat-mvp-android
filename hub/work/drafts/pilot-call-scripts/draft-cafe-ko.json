{
  "sentences": {
    "cafe.greet": { "text": "안녕하세요, 어서 오세요! 뭐 드릴까요?", "translation": "Hi, welcome! What can I get you?" },
    "cafe.sorry": { "text": "죄송한데, 한 번만 다시 말씀해 주시겠어요?", "translation": "Sorry, could you say that one more time?" },
    "cafe.recommend": { "text": "저희는 바닐라 라테가 제일 인기 많아요. 단 거 안 좋아하시면 아메리카노도 괜찮아요.", "translation": "Our vanilla latte is the most popular. If you don't like sweet things, the Americano is good too." },
    "cafe.size": { "text": "사이즈는 어떻게 해 드릴까요? 레귤러랑 라지 있어요.", "translation": "What size would you like? We have regular and large." },
    "cafe.where": { "text": "매장에서 드시고 가세요, 아니면 포장이세요?", "translation": "Is that for here, or to go?" },
    "cafe.where_explain": { "text": "아, 여기서 드시고 가시는지, 가지고 가시는지 여쭤본 거예요.", "translation": "Oh, I was asking whether you'll drink it here or take it with you." },
    "cafe.where_again": { "text": "여기서 드실 거예요, 가지고 가실 거예요?", "translation": "Will you have it here, or take it with you?" },
    "cafe.here": { "text": "네, 그럼 머그잔에 담아 드릴게요.", "translation": "Okay, then I'll put it in a mug for you." },
    "cafe.togo": { "text": "네, 포장해 드릴게요.", "translation": "Okay, I'll make it to go." },
    "cafe.pay": { "text": "결제는 어떻게 도와드릴까요?", "translation": "How would you like to pay?" },
    "cafe.card": { "text": "네, 카드는 여기 꽂아 주세요.", "translation": "Sure, please insert your card here." },
    "cafe.cash": { "text": "네, 현금 받았어요.", "translation": "Okay, I've got your cash." },
    "cafe.receipt": { "text": "영수증 드릴까요?", "translation": "Would you like a receipt?" },
    "cafe.wait": { "text": "음료 나오면 불러 드릴게요. 잠깐만 기다려 주세요!", "translation": "I'll call you when your drink is ready. Just a moment!" },
    "cafe.ready": { "text": "주문하신 음료 나왔어요! 맛있게 드세요.", "translation": "Your drink is ready! Enjoy." },
    "cafe.bye": { "text": "좋은 하루 보내세요!", "translation": "Have a nice day!" }
  },
