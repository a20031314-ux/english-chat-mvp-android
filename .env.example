# Server-only. Never expose these to the client bundle.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# YouTube Data API v3 — used by Content Discovery (video search).
YOUTUBE_API_KEY=

# RevenueCat secret API key (dashboard → API keys → secret). Lets the server ask
# RevenueCat what a subscriber actually bought instead of trusting a header the
# client sets. Without it, premium falls back to that header.
REVENUECAT_SECRET_KEY=

# Flip to "true" once the builds people are running send their RevenueCat id.
# From then on an unverified premium claim is worth nothing. Setting it earlier
# would take premium away from anyone still on an older build.
REQUIRE_VERIFIED_PREMIUM=

# Durable usage counters (free daily chats, monthly import points, catalog
# trial). Vercel's KV integration provides the first pair; Upstash directly the
# second. With neither, counters live in memory and reset when the serverless
# instance recycles, which means they do not really count.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
