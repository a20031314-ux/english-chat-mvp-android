{
  "permissions": {
    "deny": [
      "Bash(fastlane:*)",
      "Bash(bundle exec fastlane:*)",
      "Bash(gh workflow run:*)",
      "Read(android/keystore.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/play-key.json)",
      "Edit(android/keystore.properties)",
      "Edit(.github/workflows/play-production.yml)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hub.mjs\" start",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hub.mjs\" compact",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hub.mjs\" stop",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
