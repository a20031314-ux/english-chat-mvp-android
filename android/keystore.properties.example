# Copy this file to android/keystore.properties and fill in your own values.
#
# That copy is git-ignored on purpose: it holds the passwords for the key that
# Play uses to trust your uploads. If it ever leaks, anyone can publish a build
# under this app's name, so keep the .jks itself outside the repository too.
#
# Once all four values are set, `gradlew bundleRelease` signs the bundle on its
# own and there is no more signing step in Android Studio. If the file is absent
# or any value is blank the build still succeeds, but the bundle comes out
# unsigned and Gradle prints a warning saying which values were missing.

# Path to the upload keystore. Absolute, or relative to the android/ directory.
# Use forward slashes even on Windows - a backslash is an escape character here,
# so C:\Users\... would be read wrong.
storeFile=

# Password for the keystore file itself.
storePassword=

# The key inside the keystore that signs the app. If you do not remember it,
# run this in your own terminal and read "Alias name" from the output:
#   keytool -list -v -keystore <path to your .jks>
keyAlias=

# Password for that key. Often the same as storePassword.
keyPassword=
